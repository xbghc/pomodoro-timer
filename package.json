{
  "name": "pomodoro-timer",
  "version": "1.11.0",
  "description": "按工作日程运行，记录真实工作与休息时间的桌面工具",
  "main": "src/main/main.js",
  "author": "ghm",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:smoke": "node scripts/smoke-activity.js",
    "icons": "node scripts/generate-icons.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ghm.pomodoro-timer",
    "productName": "番茄钟",
    "publish": [{ "provider": "github", "owner": "xbghc", "repo": "pomodoro-timer" }],
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asarUnpack": ["**/node_modules/koffi/**", "**/node_modules/@koromix/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico",
      "executableName": "PomodoroTimer",
      "artifactName": "PomodoroTimer-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "番茄钟"
    }
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "storybook": "^10.6.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.2.1"
  }
}
